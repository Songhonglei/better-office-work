.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}

/* 状态卡片 */
.status-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.current-scenario {
  font-size: 28rpx;
  color: #666;
}

/* 区域卡片 */
.section-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

/* 按钮组 */
.scenario-buttons,
.test-buttons,
.special-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.test-buttons {
  flex-direction: column;
}

.test-buttons .van-button {
  margin-bottom: 15rpx;
}

/* 测试结果 */
.result-item {
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
}

.result-item:last-child {
  border-bottom: none;
}

.result-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.result-account {
  font-size: 24rpx;
  color: #999;
}

/* 日志容器 */
.log-container {
  height: 500rpx;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
  padding: 20rpx;
  background: #f9f9f9;
}

.log-item {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.log-item:last-child {
  border-bottom: none;
}

.log-time {
  font-size: 24rpx;
  color: #999;
}

.log-action {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.log-result {
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}

.empty-log {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 50rpx 0;
}