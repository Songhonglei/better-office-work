.container {
  padding: var(--spacing-md) var(--spacing-sm);
  background: linear-gradient(180deg, #f8f9fa 0%, #f5f5f5 100%);
  min-height: 100vh;
}

/* 头部样式 */
.header {
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-sm) 0;
}

.date {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  letter-spacing: 1rpx;
}

.test-mode-badge {
  font-size: 24rpx;
  background: #ff6b6b;
  color: white;
  padding: 5rpx 15rpx;
  border-radius: 20rpx;
  font-weight: normal;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.7; }
  100% { opacity: 1; }
}

/* 汇总卡片 */
.summary-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: white;
}

.summary-content {
  margin-bottom: var(--spacing-sm);
}

.summary-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.95);
}

.audio-controls {
  display: flex;
  justify-content: center;
  gap: var(--spacing-sm);
  flex-wrap: wrap;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: var(--bg-primary);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-sm);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-md);
  gap: var(--spacing-sm);
}

.stats-item {
  flex: 1;
  text-align: center;
  position: relative;
  transition: opacity var(--duration-fast), transform var(--duration-fast);
}

.stats-item:active {
  transform: scale(0.95);
}

.stats-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
  height: 60rpx;
  background: var(--border-color);
}

.stats-number {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 10rpx;
}

.stats-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 文章列表 */
.articles-section {
  background: var(--bg-primary);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-md);
  box-shadow: var(--shadow-md);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-sm);
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.filter-controls {
  display: flex;
  gap: 10rpx;
}

/* 文章项 */
.article-item {
  display: flex;
  padding: 25rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  transition: background var(--duration-fast);
}

.article-item:active {
  background: var(--bg-tertiary);
  border-radius: var(--radius-sm);
  margin: 0 -10rpx;
  padding: 25rpx 10rpx;
}

.article-item:last-child {
  border-bottom: none;
}

.article-info {
  flex: 1;
  margin-right: 20rpx;
}

.article-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.article-meta {
  font-size: 24rpx;
  color: #999;
  display: flex;
  gap: 15rpx;
  align-items: center;
}

.account-name {
  margin-right: 0;
}

.read-count {
  font-size: 22rpx;
  color: #ff6b6b;
  font-weight: 500;
}

.article-thumb {
  width: 120rpx;
  height: 90rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.article-thumb image {
  width: 100%;
  height: 100%;
}

/* 滑动操作 */
.swipe-right {
  height: 100%;
  display: flex;
  align-items: center;
}

.delete-btn {
  height: 100%;
  border-radius: 0;
}

/* 自定义空状态 */
.custom-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
  min-height: 300rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.6;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: var(--spacing-lg);
  padding: 0 var(--spacing-xl);
}

.empty-btn {
  margin-top: var(--spacing-sm);
}

/* 骨架屏样式 */
.skeleton-wrapper {
  padding: var(--spacing-sm) 0;
}

.skeleton-article-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--border-color);
}

.skeleton-article-item:last-child {
  border-bottom: none;
}

.skeleton-article-content {
  flex: 1;
  margin-right: var(--spacing-sm);
}

/* 分页样式 */
.pagination-section {
  margin-top: var(--spacing-lg);
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--border-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.page-info {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.view-all-btn {
  font-size: 26rpx;
}