.container {
  padding: 40rpx 20rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  justify-content: center;
  margin-bottom: 60rpx;
}

.step-dot {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 15rpx;
  transition: all 0.3s;
}

.step-dot.active {
  background: white;
  transform: scale(1.1);
}

.step-dot text {
  font-size: 26rpx;
  color: #666;
  font-weight: bold;
}

.step-dot.active text {
  color: #667eea;
}

/* 步骤内容 */
.step-content {
  background: white;
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.step-icon {
  margin-bottom: 30rpx;
}

.step-icon image {
  width: 200rpx;
  height: 200rpx;
}

.step-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.step-desc {
  font-size: 30rpx;
  color: #666;
  line-height: 1.6;
}

/* 演示区域 */
.demo-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.clipboard-tip {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #e8f5e9;
  border-radius: 10rpx;
  color: #2e7d32;
  font-size: 28rpx;
  text-align: center;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-buttons .van-button {
  flex: 1;
}

/* 跳过 */
.skip-section {
  text-align: center;
  margin-bottom: 40rpx;
}

.skip-section text {
  color: white;
  font-size: 28rpx;
  text-decoration: underline;
  opacity: 0.8;
}

/* 提示 */
.tips-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: auto;
}

.tips-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tips-list text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}