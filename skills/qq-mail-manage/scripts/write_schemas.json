          "properties": {
            "filename": {
              "type": "string",
              "description": "Attachment filename with extension"
            },
            "content_type": {
              "type": "string",
              "description": "MIME type (e.g., 'application/pdf', 'image/jpeg')"
            },
            "content": {
              "type": "string",
              "description": "Base64-encoded file content"
            },
            "size": {
              "type": "integer",
              "description": "Original file size in bytes"
            },
            "sha1": {
              "type": "string",
              "description": "SHA-1 hash of original file content (hex, 40 chars)"
            }
          },
          "required": [
            "filename",
            "content_type",
            "content",
            "size",
            "sha1"
          ]
        }
      },
      "file_refs": {
        "type": "array",
        "description": "File references from CLI upload.",
        "items": {
          "type": "object",
          "description": "File references from CLI upload.",
          "properties": {
            "file_id": {
              "type": "string",
              "description": "File ID from UploadFile response (starts with 'file_'). This is a temporary upload reference, NOT a downloadable attachment ID."
            }
          },
          "required": [
            "file_id"
          ]
        }
      },
      "skip_confirmation": {
        "type": "boolean",
        "description": "Skip confirmation when explicitly authorized by the user."
      }
    },
    "required": [
      "message_id",
      "body"
    ]
  },
